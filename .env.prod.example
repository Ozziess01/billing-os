# Копировать в .env.prod. Файл читают и compose (интерполяция), и контейнеры php (env_file).

# ---- домен и TLS
DOMAIN=billing.example.com
ACME_EMAIL=admin@example.com
# для локальной проверки: DOMAIN=localhost, HTTP_PORT=8080, HTTPS_PORT=8443
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

# ---- Laravel
APP_NAME=BillingOS
APP_ENV=production
APP_DEBUG=false
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=https://billing.example.com
FRONTEND_URL=https://billing.example.com
LOG_LEVEL=info
BCRYPT_ROUNDS=12

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=billingos
DB_USERNAME=billingos
DB_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=billing@example.com
MAIL_FROM_NAME=BillingOS

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=billingos
# openssl rand -hex 16 / 32
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_PORT=8080
REVERB_SCHEME=http

# ---- Billing
BILLING_DEFAULT_CURRENCY=EUR
BILLING_PROVIDER=fake
FAKE_WEBHOOK_URL=http://nginx/api/v1/webhooks/fake
FAKE_ASYNC_DELAY=3

# ---- Observability
METRICS_TOKEN=
SCHEDULER_MAX_AGE=180
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Frontend (вшивается при сборке образа)
NEXT_PUBLIC_API_URL=https://billing.example.com/api/v1
NEXT_PUBLIC_WS_HOST=billing.example.com
NEXT_PUBLIC_WS_PORT=443
NEXT_PUBLIC_WS_TLS=true
NEXT_PUBLIC_SENTRY_DSN=

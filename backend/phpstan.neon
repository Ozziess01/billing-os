includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
    level: 5
    tmpDir: storage/phpstan
    ignoreErrors:
        # phpredis-стаб не знает про pipeline(callable) фасада Redis
        -
            message: '#Method Redis::pipeline\(\) invoked with 1 parameter#'
            path: app/Http/Middleware/CountRequests.php
